<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorAccent">@color/purple_light</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/purple_light</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
    </style>
</resources>
